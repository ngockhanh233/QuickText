<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E4E7EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#F5F7FA">

        <HorizontalScrollView
            android:id="@+id/phrase_suggestion_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/phrase_suggestion_bar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="#D0D4D9" />

        <TextView
            android:id="@+id/globe_button"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🌐 VI"
            android:textSize="13sp"
            android:textColor="#333"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E4E8" />

    <HorizontalScrollView
        android:id="@+id/word_suggestion_scroll"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:scrollbars="none"
        android:background="#FAFBFC">

        <LinearLayout
            android:id="@+id/word_suggestion_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D4D9" />

    <FrameLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.quicktext.keyboard.QuickTextKeyboardView
            android:id="@+id/keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E4E7EB"
            android:keyBackground="@drawable/key_background"
            android:keyTextColor="#1A1A1A"
            android:keyTextSize="20sp"
            android:labelTextSize="14sp"
            android:keyPreviewLayout="@layout/key_preview"
            android:keyPreviewHeight="64dp"
            android:keyPreviewOffset="-8dp"
            android:shadowRadius="0"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <include
            android:id="@+id/emoji_picker"
            layout="@layout/emoji_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
